# Optional build cache location. When unset, Vite uses node_modules/.vite.
# Example for this workstation:
# EARTHSCOPE_CACHE_DIR=G:/_cache/earthscope/vite
# VITE_CACHE_DIR is accepted as a secondary fallback.
EARTHSCOPE_CACHE_DIR=

# Development-only illustrative sample data. Production builds default to false.
# Set to true only for an explicit UI demonstration. Never treat it as observations.
VITE_ENABLE_SAMPLE_DATA=false

# Tauri desktop builds use VITE_BASE_PATH=/ (root).
# Web/GitHub Pages builds continue to use VITE_BASE_PATH=/webquakeviewer/.
# The npm scripts build:desktop and dev:desktop set this automatically.
