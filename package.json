{
  "name": "earthscope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EarthScope — static-first earthquake monitoring and geophysical visualization platform",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:desktop": "cross-env VITE_BASE_PATH=/ vite --host 127.0.0.1",
    "build:desktop": "cross-env VITE_BASE_PATH=/ npm run build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:no-bundle": "tauri build --no-bundle",
    "tauri:info": "tauri info"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-opener": "2.7.2",
    "@types/three": "0.187.0",
    "maplibre-gl": "5.24.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@maplibre/maplibre-gl-style-spec": "24.10.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "cross-env": "10.1.0",
    "fake-indexeddb": "6.2.7",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.4"
  }
}
